# Настройки для хостинга Бегет (Apache)
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Редиректы только для боевого домена: технический адрес *.beget.tech работает без https и должен открываться как есть
  # Всегда https
  RewriteCond %{HTTP_HOST} ^(www\.)?polinaguseva\.ru$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://polinaguseva.ru%{REQUEST_URI} [L,R=301]
  # Без www
  RewriteCond %{HTTP_HOST} ^www\.polinaguseva\.ru$ [NC]
  RewriteRule ^ https://polinaguseva.ru%{REQUEST_URI} [L,R=301]
</IfModule>

ErrorDocument 404 /404.html

# Сжатие
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

# Кэш: шрифты и картинки надолго, страницы, стили и скрипты коротко (в ссылках есть версия ?v=...)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
